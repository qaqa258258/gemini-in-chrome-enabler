# 默认让 Git 自动处理换行
* text=auto

# Windows 批处理保持 CRLF
*.bat text eol=crlf

# Shell 脚本 (Mac/Linux) 必须是 LF，CRLF 会导致 "command not found"
*.command text eol=lf
*.sh text eol=lf

# Python / 配置文件统一 LF
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.ico binary
